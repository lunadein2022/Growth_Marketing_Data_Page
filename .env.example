# Local mock mode
VITE_DATA_MODE=mock
VITE_API_BASE_URL=http://localhost:8787

# --- Supabase (target backend) -------------------------------------------
# Frontend uses the anon (publishable) key only; RLS enforces access.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# AI briefing Edge Function endpoint, e.g.
#   https://YOUR_PROJECT_REF.supabase.co/functions/v1/ai-briefings
VITE_SUPABASE_FUNCTIONS_URL=

# Anthropic (Claude) key - SERVER-SIDE ONLY. Never put this in a VITE_* var.
# Set it as a Supabase Edge Function secret instead:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_API_KEY=

# YouTube Analytics sync - SERVER-SIDE ONLY. Never put these in VITE_* vars.
# Required scopes for the refresh token:
#   https://www.googleapis.com/auth/youtube.readonly
#   https://www.googleapis.com/auth/yt-analytics.readonly
# Set as Supabase Edge Function secrets:
#   supabase secrets set GOOGLE_CLIENT_ID=... GOOGLE_CLIENT_SECRET=... GOOGLE_REFRESH_TOKEN=...
# Optional:
#   supabase secrets set YOUTUBE_CHANNEL_ID=UC...
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# YOUTUBE_CHANNEL_ID=

# OAuth provider app IDs shown to the frontend only when needed.
# Provider secrets stay in Supabase (Auth settings / Edge Function secrets).
VITE_GOOGLE_CLIENT_ID=
VITE_META_APP_ID=

# Local API test:
# 1) npm run api
# 2) VITE_DATA_MODE=api
# 3) VITE_API_BASE_URL=http://localhost:8787
# 4) npm run dev

# Netlify production:
# Build command: npm run build
# Publish directory: dist
# Set VITE_DATA_MODE=api
# Set VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY / VITE_SUPABASE_FUNCTIONS_URL.
