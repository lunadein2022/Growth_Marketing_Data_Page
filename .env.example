# Local mock mode
VITE_DATA_MODE=mock
VITE_API_BASE_URL=http://localhost:8787

# --- Supabase (target backend) -------------------------------------------
# Frontend uses the anon (publishable) key only; RLS enforces access.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# AI briefing Edge Function endpoint, e.g.
#   https://YOUR_PROJECT_REF.supabase.co/functions/v1/ai-briefings
VITE_SUPABASE_FUNCTIONS_URL=

# Anthropic (Claude) key — SERVER-SIDE ONLY. Never put this in a VITE_* var.
# Set it as a Supabase Edge Function secret instead:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_API_KEY=

# --- Firebase (legacy — being migrated to Supabase) ----------------------
# Firebase Functions API mode
# Keep VITE_DATA_MODE=api and point this to the Firebase HTTPS function/API gateway.
# Example: https://asia-northeast3-YOUR_PROJECT_ID.cloudfunctions.net/api
VITE_FIREBASE_FUNCTIONS_BASE_URL=

# Firebase client config for Auth/Firestore reads in later phases.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# OAuth provider app IDs shown to the frontend only when needed.
# Secrets must stay in Firebase Functions environment/config, not Netlify.
VITE_GOOGLE_CLIENT_ID=
VITE_META_APP_ID=

# Local API test:
# 1) npm run api
# 2) VITE_DATA_MODE=api
# 3) VITE_API_BASE_URL=http://localhost:8787
# 4) npm run dev

# Netlify production:
# Build command: npm run build
# Publish directory: dist
# Set VITE_DATA_MODE=api
# Set VITE_API_BASE_URL or VITE_FIREBASE_FUNCTIONS_BASE_URL to Firebase Functions.
