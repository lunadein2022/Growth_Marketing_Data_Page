rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function marketingOwner() {
      return signedIn() && request.auth.token.email in [
        'lunadein2022@gmail.com',
        'lunachae827@gmail.com'
      ];
    }

    function validImportFile() {
      return request.resource != null
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.name.matches('.*\\.(csv|tsv|xls|xlsx|CSV|TSV|XLS|XLSX)$');
    }

    match /orgs/{orgId}/fileImports/{importId}/{fileName=**} {
      allow read: if marketingOwner();
      allow write: if marketingOwner() && orgId == 'dummdumm' && validImportFile();
    }
  }
}
